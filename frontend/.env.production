VITE_API_BASE_URL=https://gram-insta-api.onrender.com/api/v1
VITE_WS_URL=https://gram-insta-api.onrender.com/api/v1/ws

# Copy to .env and fill in real values. Spring Boot does NOT read this file automatically — export
# it into your shell before running the app locally, e.g.:
#   set -a; source .env; set +a; ./mvnw spring-boot:run
# On Render, set these as actual environment variables on the service instead (see render.yaml).

# --- Database (Neon Postgres) ---
# From the Neon console: Connection string, in JDBC form. Include ?sslmode=require.
spring.datasource.url=jdbc:postgresql://ep-dry-feather-b39iqdhq-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
spring.datasource.username=neondb_owner
spring.datasource.password=npg_3YK4oTxJNegs
# Keep small — Neon's free/hobby tiers cap concurrent connections.
DATABASE_POOL_SIZE=5

# --- Redis (Render Key Value) ---
# From the Render dashboard: the Key Value instance's "Internal" or "External" connection string.
# Use the internal one when the app itself also runs on Render; use the external one for local dev.
REDIS_URL=rediss://default:<password>@<host>:<port>

# --- Media storage (Cloudflare R2) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=<r2-access-key-id>
R2_SECRET_KEY=<r2-secret-access-key>
R2_BUCKET=instaclone-media
# R2's public bucket URL (Settings -> Public access -> r2.dev subdomain) or a custom domain you've
# mapped to the bucket.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Auth / CORS ---
# Comma-separate multiple origins, e.g. http://localhost:5173,https://your-frontend.onrender.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# false for local http://localhost dev; true once the app is only reached over https (Render).
APP_JWT_COOKIE_SECURE=false
APP_BASE_URL=http://localhost:5173